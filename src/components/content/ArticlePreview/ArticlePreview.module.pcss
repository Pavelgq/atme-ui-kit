.root {
  display: block;
  background-color: var(--palette-background-paper);
  border: var(--border-base) solid var(--palette-border-subtle);
  border-radius: var(--border-radius-lg);
  overflow: hidden;
  box-shadow: var(--shadows-sm);
  text-decoration: none;
  color: inherit;
  transition:
    box-shadow var(--transitions-duration-verySlow, 500ms) var(--transitions-easing-easeInOut),
    background-color var(--transitions-duration-verySlow, 500ms) var(--transitions-easing-easeInOut);
}

.root--interactive {
  cursor: pointer;
}

.root--interactive:hover {
  box-shadow: var(--shadows-lg);
  background-color: var(--palette-background-default);
}

.root--interactive:focus-visible {
  outline: 2px solid var(--palette-primary-main);
  outline-offset: 2px;
}

.root--card {
  max-width: 100%;
}

.root--row {
  max-width: 100%;
  border-radius: var(--border-radius-base);
  border-color: var(--palette-border-subtle);
}

