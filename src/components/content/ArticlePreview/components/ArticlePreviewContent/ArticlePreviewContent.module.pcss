.content {
  display: flex;
  flex-direction: column;
  width: 100%;
}

/* Плитка: превью сверху, контент снизу */
.content--tile .previewWrap {
  width: 100%;
  aspect-ratio: 16 / 10;
  flex-shrink: 0;
}

.content--tile .body {
  padding: spacing(3) spacing(4);
  display: flex;
  flex-direction: column;
  gap: spacing(1);
}

.content--tile .meta,
.content--row .meta {
  display: flex;
  align-items: center;
  gap: spacing(2);
  flex-wrap: wrap;
}

/* В строку: превью слева, контент справа */
.content--row {
  flex-direction: row;
}

.content--row .previewWrap {
  width: 160px;
  min-width: 160px;
  aspect-ratio: 1;
  flex-shrink: 0;
}

.content--row .body {
  padding: spacing(3) spacing(4);
  display: flex;
  flex-direction: column;
  gap: spacing(1);
  min-width: 0;
  flex: 1;
}

.previewWrap {
  position: relative;
  background-color: var(--palette-background-default);
  overflow: hidden;
}

.tagsSlotTile {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  padding: spacing(2) spacing(3);
  display: flex;
  flex-wrap: wrap;
  gap: spacing(1);
  pointer-events: auto;
}

.tagsSlotRow {
  display: flex;
  flex-wrap: wrap;
  gap: spacing(1);
  margin-bottom: spacing(1);
  pointer-events: auto;
}

.previewImage {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  vertical-align: middle;
}

.previewPlaceholder {
  width: 100%;
  height: 100%;
  min-height: 120px;
  background-color: var(--palette-border-subtle);
  background-image: repeating-linear-gradient(
    -45deg,
    transparent,
    transparent 8px,
    var(--palette-background-paper) 8px,
    var(--palette-background-paper) 10px
  );
}

.title {
  color: var(--palette-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-clamp: 2;
  margin: 0;
}

.date {
  margin: 0;
  flex-shrink: 0;
}

.description {
  margin: 0;
  color: var(--palette-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-clamp: 2;
}

.views {
  display: inline-flex;
  align-items: center;
  gap: spacing(1);
  color: var(--palette-text-secondary);
  font-size: var(--typography-font-size-xs);
  line-height: var(--typography-line-height-normal);
}

.views svg {
  flex-shrink: 0;
  opacity: 0.8;
}

/* File view — стиль файла в папке ОС */
.content--file {
  flex-direction: row;
  align-items: flex-start;
  gap: spacing(3);
  padding: spacing(2) spacing(3);
}

.content--file .fileIcon {
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--palette-background-accent);
  border-radius: var(--border-radius-base);
  color: var(--palette-primary-main);
}

.content--file .fileBody {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: spacing(1);
}

.content--file .tagsSlotFile {
  display: flex;
  flex-wrap: wrap;
  gap: spacing(1);
  pointer-events: auto;
}

.content--file .title {
  -webkit-line-clamp: 1;
  line-clamp: 1;
}

.content--file .description {
  -webkit-line-clamp: 1;
  line-clamp: 1;
}

.content--file .fileMeta {
  display: flex;
  align-items: center;
  gap: spacing(2);
  flex-wrap: wrap;
  margin-top: spacing(0.5);
}
