.content {
  display: flex;
  flex-direction: column;
  width: 100%;
}

.previewWrap {
  position: relative;
  background-color: var(--palette-background-default);
  overflow: hidden;
}

/* Row view — стиль строки как в ОС (файл в папке) */
.content--row {
  flex-direction: row;
  align-items: flex-start;
  gap: spacing(3);
  padding: spacing(2) spacing(3);
}

.content--row .rowIcon {
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: transparent;
  color: var(--palette-primary-main);
}

.content--row .rowBody {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: spacing(1);
}

.content--row .tagsSlotRow {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: spacing(1);
  pointer-events: auto;
}

.content--row .title {
  -webkit-line-clamp: 1;
  line-clamp: 1;
}

.content--row .rowMeta {
  display: flex;
  align-items: center;
  gap: spacing(2);
  flex-wrap: wrap;
  margin-top: spacing(0.5);
}

.previewImage {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  vertical-align: middle;
}

.previewPlaceholder {
  width: 100%;
  height: 100%;
  min-height: 120px;
  background-color: var(--palette-border-subtle);
  background-image: repeating-linear-gradient(
    -45deg,
    transparent,
    transparent 8px,
    var(--palette-background-paper) 8px,
    var(--palette-background-paper) 10px
  );
}

.title {
  color: var(--palette-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-clamp: 2;
  margin: 0;
}

.date {
  margin: 0;
  flex-shrink: 0;
}

.description {
  margin: 0;
  color: var(--palette-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-clamp: 2;
}

.views {
  display: inline-flex;
  align-items: center;
  gap: spacing(1);
  color: var(--palette-text-secondary);
  font-size: var(--typography-font-size-xs);
  line-height: var(--typography-line-height-normal);
}

.views svg {
  flex-shrink: 0;
  opacity: 0.8;
}

/* --- Card view: контент слева, картинка справа. Без картинки — контент на всю ширину --- */
.content--card {
  flex-direction: row;
  align-items: stretch;
  min-height: 180px;
}

.content--card .cardBody {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: spacing(2);
  padding: spacing(4);
  justify-content: center;
}

.content--card-no-image .cardBody {
  padding: spacing(4);
}

.content--card .author {
  display: flex;
  align-items: center;
  gap: spacing(2);
}

.content--card .authorAvatar {
  width: 32px;
  height: 32px;
  border-radius: var(--border-radius-full, 9999px);
  object-fit: cover;
  flex-shrink: 0;
}

.content--card .authorAvatarPlaceholder {
  width: 32px;
  height: 32px;
  border-radius: var(--border-radius-full, 9999px);
  background-color: var(--palette-primary-main);
  color: var(--palette-primary-contrast-text);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--typography-font-size-sm);
  font-weight: var(--typography-font-weight-semibold);
  flex-shrink: 0;
}

.content--card .authorName {
  color: var(--palette-text-primary);
  font-weight: var(--typography-font-weight-medium);
  margin: 0;
}

.content--card .cardFooter {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: spacing(2);
  flex-wrap: wrap;
  margin-top: auto;
  padding-top: spacing(1);
}

.content--card .tagsSlotCard {
  display: flex;
  flex-wrap: wrap;
  gap: spacing(1);
  pointer-events: auto;
}

.content--card .meta {
  display: flex;
  align-items: center;
  gap: spacing(2);
  flex-wrap: wrap;
  margin-left: auto;
}

.content--card .readingTime {
  display: inline-flex;
  align-items: center;
  gap: spacing(1);
  color: var(--palette-text-secondary);
  font-size: var(--typography-font-size-xs);
  line-height: var(--typography-line-height-normal);
}

.content--card .readingTime svg {
  flex-shrink: 0;
  opacity: 0.8;
}

.content--card .previewWrap {
  width: 200px;
  min-width: 200px;
  aspect-ratio: 1;
  flex-shrink: 0;
  background-color: var(--palette-background-default);
  overflow: hidden;
}

.content--card .title {
  -webkit-line-clamp: 2;
  line-clamp: 2;
}

.content--card .description {
  -webkit-line-clamp: 2;
  line-clamp: 2;
}
