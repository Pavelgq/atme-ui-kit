.content {
  display: flex;
  flex-direction: column;
  width: 100%;
}

/* Плитка: превью сверху, контент снизу */
.content--tile .previewWrap {
  width: 100%;
  aspect-ratio: 16 / 10;
  flex-shrink: 0;
}

.content--tile .body {
  padding: spacing(3) spacing(4);
  display: flex;
  flex-direction: column;
  gap: spacing(1);
}

/* В строку: превью слева, контент справа */
.content--row {
  flex-direction: row;
}

.content--row .previewWrap {
  width: 160px;
  min-width: 160px;
  aspect-ratio: 1;
  flex-shrink: 0;
}

.content--row .body {
  padding: spacing(3) spacing(4);
  display: flex;
  flex-direction: column;
  gap: spacing(1);
  min-width: 0;
  flex: 1;
}

.previewWrap {
  position: relative;
  background-color: var(--palette-background-default);
  overflow: hidden;
}

.previewImage {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  vertical-align: middle;
}

.previewPlaceholder {
  width: 100%;
  height: 100%;
  min-height: 120px;
  background-color: var(--palette-border-subtle);
  background-image: repeating-linear-gradient(
    -45deg,
    transparent,
    transparent 8px,
    var(--palette-background-paper) 8px,
    var(--palette-background-paper) 10px
  );
}

.title {
  color: var(--palette-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-clamp: 2;
  margin: 0;
}

.date {
  margin: 0;
  flex-shrink: 0;
}
