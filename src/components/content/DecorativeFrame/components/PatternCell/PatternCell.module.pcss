.cell {
  position: absolute;
  top: 0;
  left: 0;
  opacity: 0;
  transform-origin: var(--cell-transform-origin, center center);
  animation: cellReveal var(--cell-duration, 450ms)
    var(--transitions-easing-easeOut, ease-out) forwards;
  animation-delay: var(--cell-delay, 0ms);
}

.cellInner {
  position: absolute;
  inset: 0;
  transform-origin: center center;
}

/* Animation */
.cellInner.cellBreathes {
  animation: cellBreathe 7s ease-in-out
    calc(var(--cell-delay, 0ms) + var(--cell-duration, 450ms) + var(--cell-animation-phase, 0ms)) infinite;
}

.cellInner.cellPulses {
  animation: cellPulse 6s ease-in-out
    calc(var(--cell-delay, 0ms) + var(--cell-duration, 450ms) + var(--cell-animation-phase, 0ms)) infinite;
}

.cellInner.cellOpacity {
  animation: cellOpacity 6s ease-in-out
    calc(var(--cell-delay, 0ms) + var(--cell-duration, 450ms) + var(--cell-animation-phase, 0ms)) infinite;
}

@media (prefers-reduced-motion: reduce) {
  .cell {
    animation: none;
    opacity: 1;
  }
  .cellInner.cellBreathes,
  .cellInner.cellPulses,
  .cellInner.cellOpacity {
    animation: none;
  }
}

@keyframes cellReveal {
  from {
    opacity: 0;
    transform: scale(var(--cell-scale-from, 0.9));
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes cellBreathe {
  0%, 100% {
    transform: scale(1);
  }
  33% {
    transform: scale(1.05);
  }
  66% {
    transform: scale(0.95);
  }
}

@keyframes cellPulse {
  0%, 100% {
    filter: brightness(1);
  }
  33% {
    filter: brightness(0.8);
  }
  66% {
    filter: brightness(1.2);
  }
}

@keyframes cellOpacity {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.55;
  }
}

.bg {
  position: absolute;
  inset: 0;
}

.shapeCircle {
  position: absolute;
  inset: 0;
  border-radius: 50%;
}

.shapeDot {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
}

.shapeTriangle {
  position: absolute;
  inset: 0;
}

.shapeDiamond {
  position: absolute;
  inset: 12%;
  transform: rotate(45deg);
}

.shapeCross {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.crossBar {
  position: absolute;
  width: 28%;
  height: 100%;
  left: 36%;
}

.crossBarVertical {
  position: absolute;
  width: 100%;
  height: 28%;
  top: 36%;
}

.stripes {
  position: absolute;
  inset: 0;
}

.stripe {
  position: absolute;
}
