.root {
  font-family: var(--typography-font-family);
  color: var(--palette-text-primary);
  line-height: var(--typography-line-height-relaxed);
  word-break: break-word;
}

.root :global(h1) {
  font-size: var(--typography-font-size-4xl);
  font-weight: var(--typography-font-weight-bold);
  line-height: var(--typography-line-height-tight);
  margin: 0 0 0.75em;
  color: var(--palette-text-primary);
}

.root :global(h2) {
  font-size: var(--typography-font-size-3xl);
  font-weight: var(--typography-font-weight-bold);
  line-height: var(--typography-line-height-tight);
  margin: 1.25em 0 0.5em;
  color: var(--palette-text-primary);
}

.root :global(h3) {
  font-size: var(--typography-font-size-2xl);
  font-weight: var(--typography-font-weight-semibold);
  margin: 1em 0 0.5em;
  color: var(--palette-text-primary);
}

.root :global(h4),
.root :global(h5),
.root :global(h6) {
  font-weight: var(--typography-font-weight-semibold);
  margin: 0.75em 0 0.35em;
  color: var(--palette-text-primary);
}

.root :global(h4) {
  font-size: var(--typography-font-size-xl);
}

.root :global(h5) {
  font-size: var(--typography-font-size-lg);
}

.root :global(h6) {
  font-size: var(--typography-font-size-base);
}

.root :global(p) {
  margin: 0 0 0.75em;
  font-size: var(--typography-font-size-base);
}

.root :global(p:last-child) {
  margin-bottom: 0;
}

.root :global(ul),
.root :global(ol) {
  margin: 0 0 0.75em;
  padding-left: 1.5em;
}

.root :global(li) {
  margin: 0.25em 0;
}

.root :global(blockquote) {
  margin: 0.75em 0;
  padding: 0.5em 1em;
  border-left: 4px solid var(--palette-border-default);
  background: var(--palette-background-accent);
  color: var(--palette-text-secondary);
  border-radius: 0 var(--border-radius-base) var(--border-radius-base) 0;
}

.root :global(a) {
  color: var(--palette-primary-main);
  text-decoration: underline;
}

.root :global(a:hover) {
  color: var(--palette-primary-hover);
}

.root :global(hr) {
  border: none;
  border-top: 1px solid var(--palette-border-subtle);
  margin: 1.25em 0;
}

/* Inline code (не блоки от Shiki) */
.root :global(p code),
.root :global(li code),
.root :global(td code) {
  font-size: 0.9em;
  padding: 0.15em 0.4em;
  background: var(--palette-background-accent);
  border-radius: var(--border-radius-sm);
  font-family: ui-monospace, monospace;
}

/* Блоки кода — Shiki добавляет класс .shiki и CSS-переменные для light/dark */
.root :global(pre) {
  margin: 0.75em 0;
  padding: 1em;
  border-radius: var(--border-radius-base);
  overflow: auto;
  font-size: var(--typography-font-size-sm);
  line-height: 1.6;
  box-shadow: var(--shadows-sm);
}

.root :global(pre code) {
  padding: 0;
  background: none;
  font-size: inherit;
}

/* Dual theme: светлая тема — дефолт от Shiki, тёмная — только по явному атрибуту/классу контейнера.
   Важно: системный prefers-color-scheme НЕ влияет, чтобы тулбар темы имел приоритет. */
[data-color-scheme='dark'] .root :global(.shiki),
[data-color-scheme='dark'] .root :global(.shiki span),
[data-theme='dark'] .root :global(.shiki),
[data-theme='dark'] .root :global(.shiki span),
.dark .root :global(.shiki),
.dark .root :global(.shiki span) {
  color: var(--shiki-dark) !important;
  background-color: var(--shiki-dark-bg) !important;
}

.root :global(table) {
  width: 100%;
  border-collapse: collapse;
  margin: 0.75em 0;
  font-size: var(--typography-font-size-sm);
}

.root :global(th),
.root :global(td) {
  border: 1px solid var(--palette-border-subtle);
  padding: 0.5em 0.75em;
  text-align: left;
}

.root :global(th) {
  font-weight: var(--typography-font-weight-semibold);
  background: var(--palette-background-accent);
}

.root :global(tr:nth-child(even)) {
  background: var(--palette-background-paper);
}

.loading {
  min-height: 2em;
  display: flex;
  align-items: center;
}

.loadingText {
  color: var(--palette-text-secondary);
  font-size: var(--typography-font-size-sm);
}

.error {
  color: var(--palette-error-main);
  font-size: var(--typography-font-size-sm);
}
