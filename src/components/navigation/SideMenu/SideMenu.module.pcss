.container {
  display: flex;
  list-style: none;
  margin: 0;
  padding: 0;
}

.container--horizontal {
  flex-direction: row;
  align-items: center;
}

.container--vertical {
  flex-direction: column;
  align-items: center;
}

.item {
  display: inline-flex;
  position: relative;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  width: 80px;
  height: 80px;
}

.link {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: currentColor;
  text-decoration: none;
  border: none;
  background-color: transparent;
  padding: 0;
  position: relative;
  cursor: pointer;
  font-family: inherit;
  font-size: inherit;
}

.link:focus-visible {
  outline: 2px solid var(--palette-primary-main, currentColor);
  outline-offset: 2px;
  border-radius: 4px;
}

.icon {
  width: 100%;
  height: 100%;
  transform-origin: 50% 50%;
  transition: transform 0.3s ease;
  flex-shrink: 0;
}

.title {
  display: none;
  position: absolute;
  bottom: calc(100% + 12px);
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
  background-color: rgba(0, 0, 0, 0.8);
  color: #fff;
  padding: 4px 8px;
  border-radius: 6px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
  font-size: 0.875rem;
  z-index: 10;
}

.container--vertical .title {
  right: calc(100% + 12px);
  left: auto;
  bottom: 50%;
  transform: translateY(50%);
}

.item:hover .title {
  display: inline-block;
  opacity: 1;
}

.easeInAnimation {
  transition: width 0.3s ease, height 0.3s ease;
}

@media (prefers-reduced-motion: reduce) {
  .easeInAnimation,
  .icon,
  .title {
    transition: none;
  }
}

