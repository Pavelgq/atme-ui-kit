.tag {
  display: inline-flex;
  align-items: center;
  gap: spacing(1);
  border: var(--border-base) solid transparent;
  border-radius: var(--border-radius-md);
  font-family: var(--typography-font-family);
  font-weight: var(--typography-font-weight-medium);
  letter-spacing: 0.02em;
  line-height: 1;
  white-space: nowrap;
  transition:
    background-color var(--transitions-duration-fast) var(--transitions-easing-easeOut),
    border-color var(--transitions-duration-fast) var(--transitions-easing-easeOut),
    color var(--transitions-duration-fast) var(--transitions-easing-easeOut),
    box-shadow var(--transitions-duration-fast) var(--transitions-easing-easeOut),
    transform var(--transitions-duration-fast) var(--transitions-easing-easeOut);
}

.tag a {
  text-decoration: none;
  color: inherit;
}

.tag--link {
  text-decoration: none;
  color: inherit;
  cursor: pointer;
}

@media (hover: hover) and (pointer: fine) {
  .tag--link:hover,
  .tag:has(a:hover) {
    filter: brightness(1.06);
  }

  .tag--link:active,
  .tag:has(a:active) {
    box-shadow: none;
    transform: translateY(1px);
  }
}

.tag--link:focus-visible {
  outline: 2px solid var(--palette-primary-main);
  outline-offset: 2px;
}

.tagContent {
  display: inline-flex;
  align-items: center;
}

.tagIcon {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  font-size: 1em;
}

.tagIcon svg {
  width: 1em;
  height: 1em;
}

.tagHashIcon {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  opacity: 0.7;
}

.tagClose {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 1em;
  height: 1em;
  padding: 0;
  background: none;
  border: none;
  cursor: pointer;
  color: inherit;
  opacity: 0.7;
  transition: opacity var(--transitions-duration-base) var(--transitions-easing-easeInOut);

  &:hover {
    opacity: 1;
  }

  &:focus {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
}


/* Sizes */
.tag--sm {
  padding: spacing(1) spacing(2);
  font-size: var(--typography-font-size-xs);
}

.tag--md {
  padding: spacing(1) spacing(3);
  font-size: var(--typography-font-size-sm);
}

.tag--lg {
  padding: spacing(2) spacing(4);
  font-size: var(--typography-font-size-base);
}

/* Icon padding adjustments */
.tag--sm.tag--hasLeadingIcon  { padding-left: spacing(1.5); }
.tag--md.tag--hasLeadingIcon  { padding-left: spacing(2); }
.tag--lg.tag--hasLeadingIcon  { padding-left: spacing(3); }

.tag--sm.tag--hasTrailingIcon { padding-right: spacing(1.5); }
.tag--md.tag--hasTrailingIcon { padding-right: spacing(2); }
.tag--lg.tag--hasTrailingIcon { padding-right: spacing(3); }

/* Filled — цветной фон с твёрдой тенью снизу, как рельефная наклейка */
.tag--primary {
  background-color: var(--palette-primary-main);
  color: var(--palette-primary-contrast-text);
  border-color: var(--palette-primary-active);
  box-shadow: 0 1px 0 0 var(--palette-primary-active);
}

/* Outlined — библиотечный ярлычок: бумажный фон, цветная рамка */
.tag--secondary {
  background-color: var(--palette-background-paper);
  color: var(--palette-secondary-main);
  border-color: var(--palette-secondary-main);
  box-shadow: 0 1px 0 0 var(--palette-secondary-main);
}

.tag--success {
  background-color: var(--palette-success-main);
  color: var(--palette-success-contrast-text);
  border-color: var(--palette-success-active);
  box-shadow: 0 1px 0 0 var(--palette-success-active);
}

.tag--warning {
  background-color: var(--palette-warning-main);
  color: var(--palette-warning-contrast-text);
  border-color: var(--palette-warning-active);
  box-shadow: 0 1px 0 0 var(--palette-warning-active);
}

.tag--error {
  background-color: var(--palette-error-main);
  color: var(--palette-error-contrast-text);
  border-color: var(--palette-error-active);
  box-shadow: 0 1px 0 0 var(--palette-error-active);
}

.tag--neutral {
  background-color: var(--palette-background-paper);
  color: var(--palette-text-primary);
  border-color: var(--palette-border-default);
  box-shadow: 0 1px 0 0 var(--palette-border-default);
}

