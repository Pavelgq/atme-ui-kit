.tag {
  display: inline-flex;
  align-items: center;
  gap: spacing(1);
  border-radius: var(--border-radius-base);
  border: 2px solid transparent;
  font-family: var(--typography-font-family);
  font-weight: var(--typography-font-weight-medium);
  line-height: 1;
  white-space: nowrap;
  transition: transform var(--transitions-duration-base) var(--transitions-easing-easeInOut);
}

.tag a {
  text-decoration: none;
  color: inherit;
}

.tag--link {
  text-decoration: none;
  color: inherit;
  cursor: pointer;
}

.tag--link:hover,
.tag:has(a:hover) {
  transform: scale(1.05);
}

.tag--link:focus-visible {
  outline: 2px solid var(--palette-primary-main);
  outline-offset: 2px;
}

.tagContent {
  display: inline-flex;
  align-items: center;
}

.tagIcon {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  font-size: 1em;
}

.tagIcon svg {
  width: 1em;
  height: 1em;
}

.tagClose {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-left: spacing(1);
  padding: 0;
  background: none;
  border: none;
  cursor: pointer;
  font-size: 1.2em;
  line-height: 1;
  color: inherit;
  opacity: 0.7;
  transition: opacity var(--transitions-duration-base) var(--transitions-easing-easeInOut);

  &:hover {
    opacity: 1;
  }

  &:focus {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
}

/* Sizes */
.tag--sm {
  padding: spacing(1) spacing(2);
  font-size: var(--typography-font-size-xs);
}

.tag--md {
  padding: spacing(1) spacing(3);
  font-size: var(--typography-font-size-sm);
}

.tag--lg {
  padding: spacing(2) spacing(4);
  font-size: var(--typography-font-size-base);
}

.tag--primary {
  --tag-bg: var(--palette-primary-main);
  background-color: var(--tag-bg);
  color: color-mix(in srgb, var(--tag-bg) 35%, black);
  border-color: color-mix(in srgb, var(--tag-bg) 35%, black);
}

.tag--secondary {
  --tag-bg: var(--palette-secondary-main);
  background-color: var(--tag-bg);
  color: color-mix(in srgb, var(--tag-bg) 35%, black);
  border-color: color-mix(in srgb, var(--tag-bg) 35%, black);
}

.tag--success {
  --tag-bg: var(--palette-success-main);
  background-color: var(--tag-bg);
  color: color-mix(in srgb, var(--tag-bg) 45%, black);
  border-color: color-mix(in srgb, var(--tag-bg) 45%, black);
}

.tag--warning {
  --tag-bg: var(--palette-warning-main);
  background-color: var(--tag-bg);
  color: color-mix(in srgb, var(--tag-bg) 45%, black);
  border-color: color-mix(in srgb, var(--tag-bg) 45%, black);
}

.tag--error {
  --tag-bg: var(--palette-error-main);
  background-color: var(--tag-bg);
  color: color-mix(in srgb, var(--tag-bg) 45%, black);
  border-color: color-mix(in srgb, var(--tag-bg) 45%, black);
}

.tag--neutral {
  --tag-bg: var(--palette-border-default);
  background-color: var(--tag-bg);
  color: color-mix(in srgb, var(--tag-bg) 45%, black);
  border-color: color-mix(in srgb, var(--tag-bg) 45%, black);
}

