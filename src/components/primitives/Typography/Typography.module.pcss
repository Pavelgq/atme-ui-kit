.typography {
  font-family: var(--typography-font-family);
  margin: 0;
  padding: 0;
}

/* Variants */
.typography--h1 {
  font-size: var(--typography-font-size-4xl);
  font-weight: var(--typography-font-weight-bold);
  line-height: var(--typography-line-height-tight);
  color: var(--palette-text-primary);
}

.typography--h2 {
  font-size: var(--typography-font-size-3xl);
  font-weight: var(--typography-font-weight-bold);
  line-height: var(--typography-line-height-tight);
  color: var(--palette-text-primary);
}

.typography--h3 {
  font-size: var(--typography-font-size-xl);
  font-weight: var(--typography-font-weight-semibold);
  line-height: var(--typography-line-height-normal);
  color: var(--palette-text-primary);
}

.typography--h4 {
  font-size: var(--typography-font-size-xl);
  font-weight: var(--typography-font-weight-semibold);
  line-height: var(--typography-line-height-normal);
  color: var(--palette-text-primary);
}

.typography--h5 {
  font-size: var(--typography-font-size-lg);
  font-weight: var(--typography-font-weight-medium);
  line-height: var(--typography-line-height-normal);
  color: var(--palette-text-primary);
}

.typography--h6 {
  font-size: var(--typography-font-size-base);
  font-weight: var(--typography-font-weight-medium);
  line-height: var(--typography-line-height-normal);
  color: var(--palette-text-primary);
}

.typography--body {
  font-size: var(--typography-font-size-base);
  font-weight: var(--typography-font-weight-normal);
  line-height: var(--typography-line-height-normal);
  color: var(--palette-text-primary);
}

.typography--caption {
  font-size: var(--typography-font-size-sm);
  font-weight: var(--typography-font-weight-normal);
  line-height: var(--typography-line-height-normal);
  color: var(--palette-text-secondary);
}

.typography--overline {
  font-size: var(--typography-font-size-xs);
  font-weight: var(--typography-font-weight-medium);
  line-height: var(--typography-line-height-normal);
  color: var(--palette-text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* Sizes - переопределяют размер для любого variant */
.typography--xs {
  font-size: var(--typography-font-size-xs);
}

.typography--sm {
  font-size: var(--typography-font-size-sm);
}

.typography--base {
  font-size: var(--typography-font-size-base);
}

.typography--lg {
  font-size: var(--typography-font-size-lg);
}

.typography--xl {
  font-size: var(--typography-font-size-xl);
}

.typography--2xl {
  font-size: var(--typography-font-size-2xl);
}

.typography--3xl {
  font-size: var(--typography-font-size-3xl);
}

.typography--4xl {
  font-size: var(--typography-font-size-4xl);
}

/* Font overrides */
.typography--font-ui {
  font-family: var(--typography-font-family);
}

.typography--font-content {
  font-family: var(--typography-font-family-content, var(--typography-font-family));
}

/* Color overrides */
.typography--color-primary {
  color: var(--palette-text-primary);
}

.typography--color-secondary {
  color: var(--palette-text-secondary);
}

.typography--color-disabled {
  color: var(--palette-text-disabled);
}
