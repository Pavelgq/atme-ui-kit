.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--border-radius-full);
  font-family: var(--typography-font-family);
  font-weight: var(--typography-font-weight-medium);
  line-height: 1;
  white-space: nowrap;
  box-sizing: border-box;
}

.badgeContent {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.badgeDot {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: inherit;
  background: currentColor;
}

/* Sizes */
.badge--sm {
  min-width: spacing(4);
  height: spacing(4);
  padding: 0 spacing(1.5);
  font-size: var(--typography-font-size-xs);
}

.badge--sm.badge--dot {
  min-width: 8px;
  width: 8px;
  height: 8px;
  padding: 0;
}

.badge--md {
  min-width: spacing(5);
  height: spacing(5);
  padding: 0 spacing(2);
  font-size: var(--typography-font-size-sm);
}

.badge--md.badge--dot {
  min-width: 10px;
  width: 10px;
  height: 10px;
  padding: 0;
}

.badge--lg {
  min-width: spacing(6);
  height: spacing(6);
  padding: 0 spacing(2.5);
  font-size: var(--typography-font-size-base);
}

.badge--lg.badge--dot {
  min-width: 12px;
  width: 12px;
  height: 12px;
  padding: 0;
}

/* Variants */
.badge--primary {
  background-color: var(--palette-primary-main);
  color: var(--palette-primary-contrast-text);
}

.badge--secondary {
  background-color: var(--palette-secondary-main);
  color: var(--palette-secondary-contrast-text);
}

.badge--success {
  background-color: var(--palette-success-main);
  color: var(--palette-success-contrast-text);
}

.badge--warning {
  background-color: var(--palette-warning-main);
  color: var(--palette-warning-contrast-text);
}

.badge--error {
  background-color: var(--palette-error-main);
  color: var(--palette-error-contrast-text);
}

.badge--neutral {
  background-color: var(--palette-border-default);
  color: var(--palette-text-primary);
}
