.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: spacing(1.5);
  border: var(--border-base) solid transparent;
  border-radius: var(--border-radius-md);
  font-family: var(--typography-font-family);
  font-weight: var(--typography-font-weight-medium);
  letter-spacing: 0.02em;
  line-height: 1;
  cursor: pointer;
  transition:
    background-color var(--transitions-duration-fast) var(--transitions-easing-easeOut),
    border-color var(--transitions-duration-fast) var(--transitions-easing-easeOut),
    color var(--transitions-duration-fast) var(--transitions-easing-easeOut),
    box-shadow var(--transitions-duration-fast) var(--transitions-easing-easeOut),
    transform var(--transitions-duration-fast) var(--transitions-easing-easeOut);
  text-decoration: none;
  user-select: none;
  white-space: nowrap;

  &:focus-visible {
    outline: 2px solid var(--palette-primary-main);
    outline-offset: 2px;
  }

  &:disabled,
  &[aria-disabled="true"] {
    cursor: not-allowed;
    opacity: 0.5;
    box-shadow: none;
    transform: none;
  }
}

.buttonContent {
  display: inline-flex;
  align-items: center;
}

.buttonIcon {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
}

.buttonSpinner {
  display: inline-block;
  width: 1em;
  height: 1em;
  border: 2px solid currentColor;
  border-right-color: transparent;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* Sizes */
.button--sm {
  padding: spacing(1) spacing(3);
  font-size: var(--typography-font-size-sm);
  min-height: 28px;
}

.button--md {
  padding: spacing(1.5) spacing(4);
  font-size: var(--typography-font-size-base);
  min-height: 36px;
}

.button--lg {
  padding: spacing(2) spacing(5);
  font-size: var(--typography-font-size-lg);
  min-height: 44px;
}

.button--fullWidth {
  width: 100%;
}

/* Icon padding adjustments */
.button--sm.button--hasStartIcon { padding-left: spacing(2); }
.button--md.button--hasStartIcon { padding-left: spacing(3); }
.button--lg.button--hasStartIcon { padding-left: spacing(4); }

.button--sm.button--hasEndIcon { padding-right: spacing(2); }
.button--md.button--hasEndIcon { padding-right: spacing(3); }
.button--lg.button--hasEndIcon { padding-right: spacing(4); }

/* Variants */

/* PRIMARY — warm raised button with depth */
.button--primary {
  background-color: var(--palette-primary-main);
  color: var(--palette-primary-contrast-text);
  border-color: var(--palette-primary-active);
  box-shadow:
    0 2px 0 0 var(--palette-primary-active),
    0 1px 4px rgba(0, 0, 0, 0.12);
}

/* SECONDARY — clean paper button with neutral depth */
.button--secondary {
  background-color: var(--palette-background-paper);
  color: var(--palette-text-primary);
  border-color: var(--palette-border-default);
  box-shadow:
    0 2px 0 0 var(--palette-border-default),
    0 1px 3px rgba(0, 0, 0, 0.06);
}

/* OUTLINE — transparent, fills on hover */
.button--outline {
  background-color: transparent;
  color: var(--palette-primary-main);
  border-color: var(--palette-primary-main);
  box-shadow: none;
}

/* GHOST — minimal, barely there */
.button--ghost {
  background-color: transparent;
  color: var(--palette-primary-main);
  border-color: transparent;
  box-shadow: none;
}

@media (hover: hover) and (pointer: fine) {
  /* PRIMARY */
  .button--primary:hover:not(:disabled):not([aria-disabled="true"]) {
    background-color: var(--palette-primary-hover);
    border-color: var(--palette-primary-active);
    box-shadow:
      0 2px 0 0 var(--palette-primary-active),
      0 2px 6px rgba(0, 0, 0, 0.16);
  }

  .button--primary:active:not(:disabled):not([aria-disabled="true"]) {
    background-color: var(--palette-primary-active);
    border-color: var(--palette-primary-active);
    box-shadow: none;
    transform: translateY(2px);
  }

  /* SECONDARY */
  .button--secondary:hover:not(:disabled):not([aria-disabled="true"]) {
    background-color: var(--palette-background-accent);
    border-color: var(--palette-border-strong);
    color: var(--palette-text-primary);
    box-shadow:
      0 2px 0 0 var(--palette-border-strong),
      0 1px 4px rgba(0, 0, 0, 0.08);
  }

  .button--secondary:active:not(:disabled):not([aria-disabled="true"]) {
    background-color: var(--palette-background-accent);
    border-color: var(--palette-border-strong);
    box-shadow: none;
    transform: translateY(2px);
  }

  /* OUTLINE */
  .button--outline:hover:not(:disabled):not([aria-disabled="true"]) {
    background-color: var(--palette-primary-main);
    color: var(--palette-primary-contrast-text);
    border-color: var(--palette-primary-main);
    box-shadow:
      0 2px 0 0 var(--palette-primary-active),
      0 1px 4px rgba(0, 0, 0, 0.12);
  }

  .button--outline:active:not(:disabled):not([aria-disabled="true"]) {
    background-color: var(--palette-primary-active);
    color: var(--palette-primary-contrast-text);
    border-color: var(--palette-primary-active);
    box-shadow: none;
    transform: translateY(2px);
  }

  /* GHOST */
  .button--ghost:hover:not(:disabled):not([aria-disabled="true"]) {
    background-color: color-mix(in srgb, var(--palette-primary-main) 10%, transparent);
  }

  .button--ghost:active:not(:disabled):not([aria-disabled="true"]) {
    background-color: color-mix(in srgb, var(--palette-primary-main) 18%, transparent);
    transform: translateY(1px);
  }
}

.button--loading {
  position: relative;
  color: transparent;
}
