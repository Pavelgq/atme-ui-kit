.quote {
  margin: 0.75em 0;
  padding: 0.5em 1em;
  border-left: 4px solid var(--palette-border-default);
  background: var(--palette-background-accent);
  border-radius: 0 var(--border-radius-base) var(--border-radius-base) 0;
}

.text {
  margin: 0;
}

.author {
  margin-top: 0.5em;
  margin-bottom: 0;
}
