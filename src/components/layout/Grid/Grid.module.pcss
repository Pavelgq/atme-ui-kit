.grid {
  display: grid;
}

/* Адаптивные колонки через CSS переменные */
/* sm: 640px */
@media (min-width: 640px) {
  .grid {
    grid-template-columns: repeat(var(--grid-cols-sm, var(--grid-cols-xs, 1)), 1fr);
  }
}

/* md: 768px */
@media (min-width: 768px) {
  .grid {
    grid-template-columns: repeat(var(--grid-cols-md, var(--grid-cols-sm, var(--grid-cols-xs, 1))), 1fr);
  }
}

/* lg: 1024px */
@media (min-width: 1024px) {
  .grid {
    grid-template-columns: repeat(var(--grid-cols-lg, var(--grid-cols-md, var(--grid-cols-sm, var(--grid-cols-xs, 1)))), 1fr);
  }
}

/* xl: 1280px */
@media (min-width: 1280px) {
  .grid {
    grid-template-columns: repeat(var(--grid-cols-xl, var(--grid-cols-lg, var(--grid-cols-md, var(--grid-cols-sm, var(--grid-cols-xs, 1))))), 1fr);
  }
}

/* 2xl: 1536px */
@media (min-width: 1536px) {
  .grid {
    grid-template-columns: repeat(var(--grid-cols-2xl, var(--grid-cols-xl, var(--grid-cols-lg, var(--grid-cols-md, var(--grid-cols-sm, var(--grid-cols-xs, 1)))))), 1fr);
  }
}

